# Используем официальный образ Python
FROM python:3.13-slim

# Устанавливаем системные зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем Poetry и Gunicorn
RUN pip install --no-cache-dir poetry gunicorn

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей
COPY pyproject.toml poetry.lock /app/

# Настраиваем Poetry не создавать виртуальное окружение внутри контейнера
RUN poetry config virtualenvs.create false

# Устанавливаем зависимости (только основные, без dev)
RUN poetry install --no-interaction --no-ansi --no-root --only main

# Копируем весь проект
COPY . /app/

# Создаем директории для статики и медиа
RUN mkdir -p /app/staticfiles /app/media

# Собираем статику (опционально, можно делать при запуске)
# RUN python manage.py collectstatic --noinput

# Открываем порт 8000 для Gunicorn
EXPOSE 8000

# Запускаем через Gunicorn (production)
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "config.wsgi:application"]
