# DJANGO SETTINGS

# Django Secret Key (generate a strong one for production!)
SECRET_KEY=your-production-secret-key-change-this

# Debug mode (MUST BE FALSE in production!)
DEBUG=False

# Allowed Hosts (add your server IP/domain)
ALLOWED_HOSTS=158.160.94.94,localhost,127.0.0.1

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=http://158.160.94.94

# DATABASE CONFIGURATION

# For Docker Compose production
DB_NAME=drf_30_prod
DB_USER=postgres_prod
DB_PASSWORD=strong-production-db-password-change-this
DB_HOST=db  # ← 'db' is service name in docker-compose.prod.yml
DB_PORT=5432

# STRIPE PAYMENT SETTINGS

STRIPE_API_KEY=
STRIPE_PUBLIC_KEY=

# REDIS SETTINGS (for Celery)

# For Docker Compose production
REDIS_HOST=redis  # ← 'redis' is service name in docker-compose.prod.yml
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# EMAIL SETTINGS

# For production - uncomment and configure one of these:

# Mail.ru
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mail.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=your_email@mail.ru
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=your_email@mail.ru

# Gmail
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=your_email@gmail.com

# For development/testing (default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# TIMEZONE SETTINGS

TIME_ZONE=Europe/Moscow
USE_TZ=True

# CELERY SETTINGS

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
